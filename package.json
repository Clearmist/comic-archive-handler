{
  "name": "@clearmist-labs/comic-archive-handler",
  "version": "1.3.0",
  "description": "Detect, convert, and manipulate comic book archives: container conversion, edit metadata, image re-encoding, perceptual + content hashing.",
  "keywords": [
    "7z",
    "archive",
    "asar",
    "cba",
    "cbr",
    "cbt",
    "cbz",
    "comic",
    "comicinfo",
    "metroninfo",
    "phash",
    "rar",
    "tar",
    "zip"
  ],
  "homepage": "https://github.com/Clearmist/comic-archive-handler",
  "bugs": "https://github.com/Clearmist/comic-archive-handler/issues",
  "license": "MIT",
  "author": {
    "name": "Matthew Sanders"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clearmist/comic-archive-handler.git"
  },
  "files": [
    "dist",
    "docs",
    "schemas"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "check": "npm run typecheck && npm run lint && npx oxfmt . --check",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "7zip-bin-full": "^26.3.1",
    "@electron/asar": "^4.3.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "file-type": "^22.1.0",
    "node-unrar-js": "^2.0.2",
    "sharp": "^0.35.4",
    "tar-stream": "^3.2.1",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/tar-stream": "^3.1.4",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
